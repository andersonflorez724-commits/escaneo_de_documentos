# ===========================================================================
#  Lector e Inspector de Documentos de Identificacion
#  Copia este archivo como `.env` y ajusta los valores.
#      cp .env.example .env
# ===========================================================================

# ------------------------------- FastAPI -----------------------------------
APP_NAME=Lector e Inspector de Documentos
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Origenes permitidos por CORS (separados por coma). Vacio = mismo origen.
# En el contenedor RapidOCR incluye el dominio de Vercel si el navegador
# alguna vez habla directamente con la API (por ejemplo /docs).
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://escaneo-de-documentos.vercel.app

# --------------------------- Motor de OCR (ML) ----------------------------
# auto      -> RapidOCR si esta instalado, si no EasyOCR, si no heuristico
#              (en Vercel el bundle incluye RapidOCR; si falta, los campos
#              de identificacion salen vacios: revisa api/requirements.txt)
# rapidocr  -> modelos PaddleOCR via ONNX (recomendado: ~300 MB RAM, sin torch)
# easyocr   -> fuerza EasyOCR + PyTorch (~2 GB; solo local)
# heuristic -> motor ligero sin reconocimiento (solo inspeccion)
OCR_ENGINE=auto
OCR_LANGUAGES=es,en
OCR_USE_GPU=false
OCR_MIN_CONFIDENCE=0.20

# MAX_IMAGE_DIMENSION controla el coste de la inferencia en CPU. La MRZ tiene
# su propia pasada ampliada, asi que la pagina completa no necesita resolucion
# alta. Bajarlo acelera el escaneo; subirlo ayuda con letra muy pequena.
# En Render Free (512 MB) usa 1024 si ves OOM.
MAX_IMAGE_DIMENSION=1280

# Hilos de ONNX Runtime / OpenMP. 1 = minimo consumo de RAM y CPU
# (recomendado en contenedores gratuitos con 0.1 vCPU).
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1

# Lienzo del detector. Dejarlo vacio o en 0 lo ajusta al tamano real de la
# imagen, que es lo mas rapido. El valor por defecto de EasyOCR (2560) rellena
# hasta un cuadrado de 2560x2560 y triplica el tiempo sin mejorar la lectura.
OCR_CANVAS_SIZE=0

# Maximo de lineas de texto crudo devueltas en la respuesta.
OCR_MAX_TEXT_LINES=80

# --------------------------- Deteccion de rostro ---------------------------
# auto / opencv / heuristic
FACE_DETECTOR=auto

# ------------------------- Limites de subida -------------------------------
# En Vercel el limite de cuerpo es ~4.5 MB: usa 4 en produccion serverless.
MAX_UPLOAD_MB=8

# -------------------------------- Django -----------------------------------
DJANGO_SECRET_KEY=django-insecure-cambia-esta-clave-por-favor-0987654321
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# URL publica del backend FastAPI. Vacio = mismo origen (Vercel sirve
# Django y FastAPI bajo el mismo dominio; no hace falta configurarlo alli).
# En produccion apunta al contenedor RapidOCR, p. ej.:
#   FASTAPI_BASE_URL=https://escaneo-backend.onrender.com
FASTAPI_BASE_URL=http://127.0.0.1:8001

# Vercel: permite funciones Python mas grandes (hasta ~5 GB) si el bundle
# con OpenCV supera el limite estandar. Usar solo en el panel de Vercel.
# VERCEL_SUPPORT_LARGE_FUNCTIONS=1
