# ===========================================================================
#  Lector e Inspector de Documentos de Identificacion
#  Copia este archivo como `.env` y ajusta los valores.
#      cp .env.example .env
# ===========================================================================

# ------------------------------- FastAPI -----------------------------------
APP_NAME=Lector e Inspector de Documentos
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Clave para firmar los JWT. Generar una nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-en-produccion-por-favor-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Origenes permitidos por CORS (separados por coma). Vacio = mismo origen.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --------------------------- Motor de OCR (ML) ----------------------------
# auto      -> usa EasyOCR si esta instalado, si no cae al motor heuristico
# easyocr   -> fuerza el modelo preentrenado EasyOCR + OpenCV
# heuristic -> motor ligero sin torch (util para serverless / Vercel)
OCR_ENGINE=auto
OCR_LANGUAGES=es,en
OCR_USE_GPU=false
OCR_MIN_CONFIDENCE=0.30
MAX_IMAGE_DIMENSION=1600

# --------------------------- Deteccion de rostro ---------------------------
# auto / opencv / heuristic
FACE_DETECTOR=auto

# ------------------------- Limites de subida -------------------------------
MAX_UPLOAD_MB=8

# -------------------- Usuario semilla (demo) de la API ---------------------
SEED_USER_EMAIL=admin@escaneo.local
SEED_USER_PASSWORD=Admin123*
SEED_USER_NAME=Administrador

# -------------------------------- Django -----------------------------------
DJANGO_SECRET_KEY=django-insecure-cambia-esta-clave-por-favor-0987654321
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# URL publica del backend FastAPI consumida por el cliente Django
FASTAPI_BASE_URL=http://127.0.0.1:8001
# Token interno opcional para automatizar el login Django -> FastAPI
FASTAPI_SERVICE_EMAIL=admin@escaneo.local
FASTAPI_SERVICE_PASSWORD=Admin123*
